# Copy to .env and fill in. .env is gitignored — never commit real values.

# Slack — from your app at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token        # OAuth & Permissions → Bot User OAuth Token
SLACK_APP_TOKEN=xapp-your-app-token        # Basic Information → App-Level Tokens (connections:write) — Socket Mode (local dev) only
SLACK_SIGNING_SECRET=                                                              # Basic Information → App Credentials → Signing Secret — required for HTTP mode (Lambda)

# AWS DynamoDB — see ADR-0001 (docs/adr/0001-dynamodb-for-persistence.md) and SETUP.md §2.
# Credentials use the standard boto3 chain; set the IAM user's access key here.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...                 # IAM user → Security credentials → access key id
AWS_SECRET_ACCESS_KEY=...                 # the matching secret access key
# Table names (optional; defaults shown). Must match what seed.create_tables() provisions.
EMPLOYEES_TABLE=leave_employees
REQUESTS_TABLE=leave_requests

# Google Calendar
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json   # path to the downloaded JSON key
TEAM_CALENDAR_ID=your-team-calendar-id@group.calendar.google.com     # Calendar settings → Integrate calendar → Calendar ID
