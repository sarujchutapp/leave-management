# Copy to .env and fill in. .env is gitignored — never commit real values.

# Slack — from your app at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token        # OAuth & Permissions → Bot User OAuth Token
SLACK_APP_TOKEN=xapp-your-app-token        # Basic Information → App-Level Tokens (connections:write)

# Postgres — connection string from Supabase/Neon
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Google Calendar
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json   # path to the downloaded JSON key
TEAM_CALENDAR_ID=your-team-calendar-id@group.calendar.google.com     # Calendar settings → Integrate calendar → Calendar ID
