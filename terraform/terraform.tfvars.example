# Copy to terraform.tfvars (gitignored) and fill in. Only the two required vars
# are shown; the rest have defaults in variables.tf.
aws_region       = "ap-southeast-1"
team_calendar_id = "your-team-calendar-id@group.calendar.google.com"

# Optional: Slack member IDs allowed to use /control (comma-separated). Empty
# (the default) means no admins, so /control does nothing. e.g. "U0XXXXXXX,U0YYYYYYY".
# slack_admin_ids = ""
